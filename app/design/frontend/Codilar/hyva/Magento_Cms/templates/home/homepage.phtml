$categories = [
    ['name' => 'Clothing', 'url' => 'clothing.html'],
    ['name' => 'Footwear', 'url' => 'footwear.html'],
    ['name' => 'Bags', 'url' => 'bags.html'],
    ['name' => 'Beauty', 'url' => 'beauty.html'],
