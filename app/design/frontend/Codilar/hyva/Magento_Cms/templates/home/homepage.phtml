    ['title' => 'Support that cares', 'text' => 'We are here to help with every order.'],
];
?>
<div class="space-y-16 pb-16">

    <?php // Hero slider: Alpine keeps the active slide index and rotates it on a timer. ?>
    <section
        x-data="{
            active: 0,
            total: <?= count($slides) ?>,
            timer: null,
            go(i) { this.active = (i + this.total) % this.total; },
            start() { this.stop(); this.timer = setInterval(() => this.go(this.active + 1), 5000); },
            stop() { clearInterval(this.timer); }
        }"
        x-init="start()"
        @mouseenter="stop()"
        @mouseleave="start()"
        class="relative overflow-hidden rounded-3xl"
        aria-roledescription="carousel"
    >
        <?php foreach ($slides as $i => $slide): ?>
            <div
                x-show="active === <?= $i ?>"
                x-transition.opacity.duration.500ms
                <?= $i > 0 ? 'x-cloak' : '' ?>
                class="bg-gradient-to-br <?= $escaper->escapeHtmlAttr($slide['bg']) ?> text-white"
            >
                <div class="px-6 py-16 sm:px-12 sm:py-24 lg:py-32 max-w-3xl">
                    <p class="text-sm font-semibold uppercase tracking-widest opacity-90">
                        <?= $escaper->escapeHtml(__($slide['eyebrow'])) ?>
                    </p>
                    <h1 class="mt-3 text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
                        <?= $escaper->escapeHtml(__($slide['title'])) ?>
                    </h1>
                    <p class="mt-4 text-lg opacity-90">
                        <?= $escaper->escapeHtml(__($slide['text'])) ?>
                    </p>
                    <a href="<?= $escaper->escapeUrl($block->getUrl($slide['url'])) ?>"
                       class="mt-8 inline-block rounded-full bg-white px-8 py-3 font-semibold text-slate-900 shadow transition hover:bg-slate-100">
                        <?= $escaper->escapeHtml(__($slide['cta'])) ?>
                    </a>
                </div>
            </div>
        <?php endforeach; ?>

        <div class="absolute bottom-4 left-0 right-0 flex items-center justify-center gap-2">
            <?php foreach ($slides as $i => $slide): ?>
                <button
                    type="button"
                    @click="go(<?= $i ?>)"
                    :class="active === <?= $i ?> ? 'w-8 bg-white' : 'w-3 bg-white/50'"
                    class="h-3 rounded-full transition-all"
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Go to slide %1', $i + 1)) ?>"
                ></button>
            <?php endforeach; ?>
        </div>
    </section>

    <section>
        <h2 class="text-2xl font-bold sm:text-3xl"><?= $escaper->escapeHtml(__('Shop by category')) ?></h2>
        <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3">
            <?php foreach ($categories as $category): ?>
                <a href="<?= $escaper->escapeUrl($block->getUrl($category['url'])) ?>"
                   class="group flex h-32 items-end rounded-2xl bg-slate-100 p-5 transition hover:bg-primary hover:text-on-primary sm:h-40">
                    <span class="text-lg font-semibold">
                        <?= $escaper->escapeHtml(__($category['name'])) ?>
                        <span class="inline-block transition group-hover:translate-x-1">&rarr;</span>
                    </span>
                </a>
            <?php endforeach; ?>
        </div>
    </section>

    <section class="grid gap-6 rounded-3xl bg-slate-50 p-8 sm:grid-cols-3">
        <?php foreach ($benefits as $benefit): ?>
            <div>
                <h3 class="font-semibold"><?= $escaper->escapeHtml(__($benefit['title'])) ?></h3>
                <p class="mt-1 text-sm text-slate-600"><?= $escaper->escapeHtml(__($benefit['text'])) ?></p>
            </div>
        <?php endforeach; ?>
    </section>

</div>
