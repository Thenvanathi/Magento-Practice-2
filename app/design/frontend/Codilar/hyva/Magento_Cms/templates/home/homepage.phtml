        'bg' => 'from-emerald-600 to-teal-500',
    ],
    [
        'eyebrow' => 'Glow up',
        'title' => 'Beauty essentials',
        'text' => 'Makeup and skincare to build a routine you will enjoy.',
        'cta' => 'Shop beauty',
