<?php
declare(strict_types=1);

use Codilar\Homepage\ViewModel\Homepage;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Homepage $viewModel */
$viewModel = $block->getData('view_model');

$sections = $viewModel->getBeautySections();
$extraCategories = $viewModel->getExtraCategories();
$routine = $viewModel->getRoutine();

// Soft tile colours, repeated if there are more categories than colours.
$tones = ['bg-rose-50 hover:bg-rose-100', 'bg-amber-50 hover:bg-amber-100', 'bg-emerald-50 hover:bg-emerald-100'];

$firstUrl = $sections[0]['url'] ?? '';
$collage = [];
foreach ($sections as $section) {
    if (!empty($section['products'])) {
        $collage[] = $section['products'][0];
    }
}

$benefits = [
    ['title' => 'Easy returns', 'text' => 'Changed your mind? Send it back hassle free.'],
    ['title' => 'Secure payment', 'text' => 'Your payment details are protected.'],
    ['title' => 'Support that cares', 'text' => 'We are here to help with every order.'],
];
?>
<div class="space-y-20 pb-20">

    <section class="overflow-hidden rounded-3xl bg-gradient-to-br from-rose-100 via-amber-50 to-white">
        <div class="grid items-center gap-10 px-6 py-12 sm:px-12 sm:py-16 lg:grid-cols-2 lg:py-20">
            <div>
                <p class="text-sm font-semibold uppercase tracking-widest text-rose-700">
                    <?= $escaper->escapeHtml(__('Beauty & self-care')) ?>
                </p>
                <h1 class="mt-4 text-4xl font-bold leading-tight text-stone-900 sm:text-5xl lg:text-6xl">
                    <?= $escaper->escapeHtml(__('Glow, your way.')) ?>
                </h1>
                <p class="mt-5 max-w-md text-lg text-stone-600">
                    <?= $escaper->escapeHtml(__('Makeup, skincare and hair care picked to build a routine you will actually enjoy.')) ?>
                </p>
                <?php if ($firstUrl): ?>
                    <div class="mt-8 flex flex-wrap gap-3">
                        <a href="#shop"
                           class="rounded-full bg-stone-900 px-8 py-3 font-semibold text-white shadow transition hover:bg-stone-700">
                            <?= $escaper->escapeHtml(__('Shop the edit')) ?>
                        </a>
                        <a href="#routine"
                           class="rounded-full bg-white px-8 py-3 font-semibold text-stone-900 shadow transition hover:bg-stone-100">
                            <?= $escaper->escapeHtml(__('Build a routine')) ?>
                        </a>
                    </div>
                <?php endif; ?>
            </div>

            <?php if ($collage): ?>
                <div class="grid grid-cols-3 gap-3 sm:gap-4">
                    <?php foreach ($collage as $i => $product): ?>
                        <a href="<?= $escaper->escapeUrl($product['url']) ?>"
                           class="<?= $i === 1 ? 'mt-8' : '' ?> block overflow-hidden rounded-2xl bg-white shadow-md transition hover:-translate-y-1">
                            <img src="<?= $escaper->escapeUrl($product['image']) ?>"
                                 alt="<?= $escaper->escapeHtmlAttr($product['name']) ?>"
                                 class="aspect-[3/4] w-full object-cover"
                                 loading="<?= $i === 0 ? 'eager' : 'lazy' ?>">
                        </a>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
        </div>
    </section>

    <?php if ($sections): ?>
        <section>
            <h2 class="text-2xl font-bold text-stone-900 sm:text-3xl"><?= $escaper->escapeHtml(__('Shop by category')) ?></h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-3">
                <?php foreach ($sections as $i => $section): ?>
                    <a href="<?= $escaper->escapeUrl($section['url']) ?>"
                       class="group flex h-36 items-end justify-between rounded-2xl p-6 transition sm:h-44 <?= $escaper->escapeHtmlAttr($tones[$i % count($tones)]) ?>">
                        <span class="text-xl font-semibold text-stone-900"><?= $escaper->escapeHtml($section['name']) ?></span>
                        <span class="text-2xl text-stone-900 transition group-hover:translate-x-1">&rarr;</span>
                    </a>
                <?php endforeach; ?>
            </div>
        </section>

        <section id="shop" x-data="{ tab: '<?= $escaper->escapeJs($sections[0]['key']) ?>' }">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <h2 class="text-2xl font-bold text-stone-900 sm:text-3xl"><?= $escaper->escapeHtml(__('New in')) ?></h2>
                <div class="flex flex-wrap gap-2" role="tablist">
                    <?php foreach ($sections as $section): ?>
                        <button type="button"
                                role="tab"
                                @click="tab = '<?= $escaper->escapeJs($section['key']) ?>'"
                                :aria-selected="tab === '<?= $escaper->escapeJs($section['key']) ?>'"
                                :class="tab === '<?= $escaper->escapeJs($section['key']) ?>'
                                    ? 'bg-stone-900 text-white'
                                    : 'bg-stone-100 text-stone-700 hover:bg-stone-200'"
                                class="rounded-full px-5 py-2 text-sm font-semibold transition">
                            <?= $escaper->escapeHtml($section['name']) ?>
                        </button>
                    <?php endforeach; ?>
                </div>
            </div>

            <?php foreach ($sections as $i => $section): ?>
                <div x-show="tab === '<?= $escaper->escapeJs($section['key']) ?>'"
                     <?= $i > 0 ? 'x-cloak' : '' ?>
                     class="mt-8">
                    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
                        <?php foreach ($section['products'] as $product): ?>
                            <a href="<?= $escaper->escapeUrl($product['url']) ?>" class="group block">
                                <div class="overflow-hidden rounded-2xl bg-stone-100">
                                    <img src="<?= $escaper->escapeUrl($product['image']) ?>"
                                         alt="<?= $escaper->escapeHtmlAttr($product['name']) ?>"
                                         class="aspect-square w-full object-cover transition duration-300 group-hover:scale-105"
                                         loading="lazy">
                                </div>
                                <p class="mt-3 font-medium text-stone-900"><?= $escaper->escapeHtml($product['name']) ?></p>
                                <p class="text-sm text-stone-600"><?= /* @noEscape */ $product['price'] ?></p>
                            </a>
                        <?php endforeach; ?>
                    </div>
                    <a href="<?= $escaper->escapeUrl($section['url']) ?>"
                       class="mt-8 inline-block text-sm font-semibold text-rose-700 underline underline-offset-4">
                        <?= $escaper->escapeHtml(__('View all %1', $section['name'])) ?> &rarr;
                    </a>
                </div>
            <?php endforeach; ?>
        </section>
    <?php endif; ?>

    <?php if ($sections && $routine): ?>
        <section id="routine" class="rounded-3xl bg-stone-900 px-6 py-12 text-white sm:px-12">
            <h2 class="text-2xl font-bold sm:text-3xl"><?= $escaper->escapeHtml(__('Build your routine')) ?></h2>
            <p class="mt-2 max-w-xl text-stone-300">
                <?= $escaper->escapeHtml(__('Three simple steps for a glow that lasts all day.')) ?>
            </p>
            <div class="mt-8 grid gap-6 sm:grid-cols-3">
                <?php foreach ($routine as $i => $item): ?>
                    <a href="<?= $escaper->escapeUrl($item['product']['url']) ?>"
                       class="group flex items-center gap-4 rounded-2xl bg-white/10 p-4 transition hover:bg-white/20">
                        <img src="<?= $escaper->escapeUrl($item['product']['image']) ?>"
                             alt="<?= $escaper->escapeHtmlAttr($item['product']['name']) ?>"
                             class="h-24 w-24 shrink-0 rounded-xl bg-white object-cover"
                             loading="lazy">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-widest text-rose-300">
                                <?= $escaper->escapeHtml(__('Step %1', $i + 1)) ?> &middot; <?= $escaper->escapeHtml(__($item['step'])) ?>
                            </p>
                            <p class="mt-1 font-semibold"><?= $escaper->escapeHtml($item['product']['name']) ?></p>
                            <p class="text-sm text-stone-300"><?= /* @noEscape */ $item['product']['price'] ?></p>
                        </div>
                    </a>
                <?php endforeach; ?>
            </div>
        </section>
    <?php endif; ?>

    <?php if ($extraCategories): ?>
        <section>
            <h2 class="text-2xl font-bold text-stone-900 sm:text-3xl"><?= $escaper->escapeHtml(__('Also in store')) ?></h2>
            <div class="mt-6 flex flex-wrap gap-3">
                <?php foreach ($extraCategories as $category): ?>
                    <a href="<?= $escaper->escapeUrl($category['url']) ?>"
                       class="rounded-full border border-stone-300 px-6 py-3 font-medium text-stone-900 transition hover:border-stone-900 hover:bg-stone-900 hover:text-white">
                        <?= $escaper->escapeHtml($category['name']) ?>
                    </a>
                <?php endforeach; ?>
            </div>
        </section>
    <?php endif; ?>

    <section class="grid gap-6 rounded-3xl bg-stone-50 p-8 sm:grid-cols-3">
        <?php foreach ($benefits as $benefit): ?>
            <div>
                <h3 class="font-semibold text-stone-900"><?= $escaper->escapeHtml(__($benefit['title'])) ?></h3>
                <p class="mt-1 text-sm text-stone-600"><?= $escaper->escapeHtml(__($benefit['text'])) ?></p>
            </div>
        <?php endforeach; ?>
    </section>

</div>
