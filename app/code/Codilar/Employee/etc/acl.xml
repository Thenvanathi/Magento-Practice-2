<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Codilar_Employee::config" title="Employee Configuration"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="Codilar_Employee::codilar" title="Codilar" sortOrder="70">
                    <resource id="Codilar_Employee::employees" title="Employees" sortOrder="10"/>
                    <resource id="Codilar_Employee::employee_new" title="Add Employee" sortOrder="20"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
