<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <!-- cacheable="false": the list comes straight from the database and changes in the admin. -->
            <block name="codilar.employee.list" template="Codilar_Employee::employee/list.phtml" cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Codilar\Employee\ViewModel\EmployeeList</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
