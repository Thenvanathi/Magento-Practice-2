<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <!--
        Global scope: QuoteManagement::placeOrder() runs for storefront checkout, REST and GraphQL,
        so the observer must not be limited to the frontend area.
    -->
    <event name="checkout_submit_all_after">
        <observer name="codilar_order_observer_log_placement"
                  instance="Codilar\OrderObserver\Observer\LogOrderPlacement"/>
    </event>

</config>
